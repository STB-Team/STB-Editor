<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>StbEditor.App</RootNamespace>
    <AssemblyName>STBEditor</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- .NET 9+ marks the exe CET-compatible; with hardware shadow stacks on, MO2's usvfs hooks
         (and other injectors) crash the process at startup with 0xC0000005. -->
    <CETCompat>false</CETCompat>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- Also loose beside the managed assembly: the window class loads it at the sizes Windows asks for. -->
    <None Include="app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.14.0" />
    <ProjectReference Include="..\Editor.Data\Editor.Data.csproj" />
    <ProjectReference Include="..\Editor.Assets\Editor.Assets.csproj" />
    <PackageReference Include="Hexa.NET.ImGui" Version="2.2.9" />
    <PackageReference Include="Hexa.NET.ImGui.Backends" Version="1.0.18" />
    <PackageReference Include="Hexa.NET.ImGuizmo" Version="2.2.9" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Editor.Render\Editor.Render.csproj" />
    <ProjectReference Include="..\Editor.Nif\Editor.Nif.csproj" />
    <ProjectReference Include="..\Editor.Core\Editor.Core.csproj" />
  </ItemGroup>
  <!-- The SDK apphost supports a relative managed DLL path; keep the real runtime beside that DLL.
       Normal build/publish output stays unchanged unless package.ps1 requests the portable layout. -->
  <Target Name="CreatePortableHost" AfterTargets="Publish"
          DependsOnTargets="_GetAppHostPaths;_GetAppHostCreationConfiguration"
          Condition="'$(PortableLayout)' == 'true'">
    <CreateAppHost AppHostSourcePath="$(AppHostSourcePath)"
                   AppHostDestinationPath="$(PublishDir)../$(AssemblyName).exe"
                   AppBinaryName="app/$(AssemblyName)$(TargetExt)"
                   IntermediateAssembly="@(IntermediateAssembly->'%(FullPath)')"
                   WindowsGraphicalUserInterface="$(_UseWindowsGraphicalUserInterface)"
                   DisableCetCompat="$(_DisableCetCompat)" />
    <Delete Files="$(PublishDir)$(AssemblyName).exe" />
  </Target>
</Project>
